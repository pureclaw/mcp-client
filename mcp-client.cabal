cabal-version: 2.2
name: mcp-client
version: 0.1.0.0
license: BSD3
license-file: LICENSE
copyright: (c) 2025 DPella AB
author: DPella AB
tested-with: ghc ==9.12.2

maintainer:
  matti@dpella.io,
  lobo@dpella.io

synopsis: A Haskell client library for the Model Context Protocol (MCP)
description:
  This library provides a client implementation of the Model Context Protocol
  (MCP) for Haskell. It re-exports the core protocol types from @mcp-types@
  for convenience.
  .
  MCP is a protocol that enables seamless communication between AI models and
  external tools, resources, and services. This client implementation supports
  MCP protocol version 2025-06-18 with a stdio transport for subprocess-based
  integrations.

homepage: https://github.com/DPella/mcp
bug-reports: https://github.com/DPella/mcp/issues
category: Web, AI

source-repository head
  type: git
  location: https://github.com/DPella/mcp.git

library
  default-language:
    Haskell2010

  default-extensions:
    DataKinds
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    PolyKinds
    RankNTypes
    TypeApplications
    TypeFamilies

  hs-source-dirs:
    src

  exposed-modules:
    MCP.Client
    MCP.Client.API
    MCP.Client.Config
    MCP.Client.Error
    MCP.Client.Session
    MCP.Client.Transport
    MCP.Client.Transport.Stdio

  build-depends:
    aeson >=2.1 && <2.3,
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.8,
    jsonrpc >=0.2.0 && <0.3,
    mcp-types >=0.1.0 && <0.2,
    process >=1.6 && <1.8,
    text >=2.0 && <2.2,

test-suite test-mcp-client
  type: exitcode-stdio-1.0
  default-language:
    Haskell2010

  default-extensions:
    DataKinds
    DuplicateRecordFields
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies

  hs-source-dirs:
    test

  main-is:
    Main.hs

  other-modules:
    MCP.Client.StdioIntegration

  build-depends:
    aeson >=2.1 && <2.3,
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.8,
    hspec >=2.10 && <2.12,
    mcp-client,
    mcp-types >=0.1.0 && <0.2,
    mcp,
    process >=1.6 && <1.8,
    text >=2.0 && <2.2,
